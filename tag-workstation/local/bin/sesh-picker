#!/usr/bin/env bash
# ABOUTME: tmux sesh session picker — an fzf-tmux popup over `sesh list`.
# ABOUTME: Bound to prefix+T and root-table M-T in tmux; ghostty's cmd+k sends M-T.
sesh connect "$(
  sesh list --icons | fzf-tmux -p 80%,80% \
    --no-sort --ansi --border-label ' 🦔 Sessions ' --prompt '🐝 ' \
    --header ' ^a all ^t tmux ^c configs ^x zoxide ^d tmux kill ^f find' \
    --bind 'tab:down,btab:up' \
    --bind 'ctrl-a:change-prompt(🐝  )+reload(sesh list --icons)' \
    --bind 'ctrl-t:change-prompt(🪟  )+reload(sesh list -t --icons)' \
    --bind 'ctrl-c:change-prompt(⚙️  )+reload(sesh list -c --icons)' \
    --bind 'ctrl-x:change-prompt(📁  )+reload(sesh list -z --icons)' \
    --bind 'ctrl-f:change-prompt(🔎  )+reload(fd -H -d 2 -t d -E .Trash . ~)' \
    --bind 'ctrl-d:execute(tmux kill-session -t {2..})+change-prompt(🐝  )+reload(sesh list --icons)' \
)"
